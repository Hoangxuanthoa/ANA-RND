// R&D Design Library — Database Schema V1
// Source of truth: the V1 schema doc. Auth is handled by Supabase Auth
// (auth.users) — `User.id` here is set to match the corresponding
// auth.users.id, it is not independently generated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// USERS
model User {
  id         String   @id @db.Uuid
  fullName   String
  email      String   @unique
  role       Role
  avatar     String?
  customerId String?  @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  designedProducts     Product[]        @relation("Designer")
  salesProjects        Project[]        @relation("Sales")
  rndOwnerProjects      Project[]        @relation("RndOwner")
  uploadedAssets       ProductAsset[]
  uploadedVersions     ProductVersion[]
  feedback             Feedback[]
  activity             Activity[]
  addedProjectProducts ProjectProduct[]
  notifications        Notification[]
  createdCatalogs      Catalog[]

  @@map("users")
}

enum Role {
  ADMIN
  RND
  SALES
  CUSTOMER
}

// CUSTOMERS
model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  customerCode  String?
  name          String
  country       String?
  contactName   String?
  contactEmail  String?
  note          String?
  createdAt     DateTime @default(now())

  // Relations
  users          User[]
  projects       Project[]
  originProducts Product[] @relation("OriginCustomer")
  catalogs       Catalog[]

  @@map("customers")
}

// CATEGORIES
model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  isActive Boolean    @default(true)

  products Product[]

  @@map("categories")
}

// MATERIALS
model Material {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  isActive Boolean @default(true)

  products Product[]

  @@map("materials")
}

// PRODUCTS
model Product {
  id                String          @id @default(uuid()) @db.Uuid
  productCode       String          @unique
  name              String
  categoryId        String          @db.Uuid
  category          Category        @relation(fields: [categoryId], references: [id])
  materialId        String          @db.Uuid
  material          Material        @relation(fields: [materialId], references: [id])
  designerId        String          @db.Uuid
  designer          User            @relation("Designer", fields: [designerId], references: [id])
  originCustomerId  String?         @db.Uuid
  originCustomer    Customer?       @relation("OriginCustomer", fields: [originCustomerId], references: [id])
  description       String?
  status            ProductStatus   @default(DRAFT)
  reusePermission   ReusePermission @default(REUSABLE)
  // Prep for connecting the existing product website later (see doc section 21).
  sourceType        SourceType      @default(RND)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  assets          ProductAsset[]
  versions        ProductVersion[]
  projectProducts ProjectProduct[]
  feedback        Feedback[]
  activity        Activity[]
  catalogItems    CatalogItem[]

  @@map("products")
}

enum ProductStatus {
  DRAFT
  DEVELOPING
  // Submitted for Admin review — either uploaded straight to the library,
  // or released from a closed project. A reject sends it back to DRAFT
  // (the reason lives in Feedback + a Notification to the designer).
  PENDING_REVIEW
  RELEASED
  ARCHIVED
}

enum ReusePermission {
  REUSABLE
  REFERENCE_ONLY
  EXCLUSIVE
}

enum SourceType {
  RND
  EXTERNAL
}

// PRODUCT_ASSETS
model ProductAsset {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetType    AssetType
  fileName     String
  fileUrl      String
  thumbnailUrl String?
  uploadedById String    @db.Uuid
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@map("product_assets")
}

enum AssetType {
  MAIN_RENDER
  RENDER
  PRODUCT_PHOTO
  SAMPLE_PHOTO
  THREE_D_SOURCE
  DRAWING
  PDF
  OTHER
}

// PRODUCT_VERSIONS
// Versions are append-only — never delete or overwrite a previous version.
model ProductVersion {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionNumber String
  note          String?
  uploadedById  String   @db.Uuid
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())

  feedback     Feedback[]
  catalogItems CatalogItem[]

  @@unique([productId, versionNumber])
  @@map("product_versions")
}

// PROJECTS
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  projectCode String        @unique
  projectName String
  customerId  String        @db.Uuid
  customer    Customer      @relation(fields: [customerId], references: [id])
  salesId     String        @db.Uuid
  sales       User          @relation("Sales", fields: [salesId], references: [id])
  rndOwnerId  String?       @db.Uuid
  rndOwner    User?         @relation("RndOwner", fields: [rndOwnerId], references: [id])
  brief       String?
  deadline    DateTime?     @db.Date
  status      ProjectStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  projectProducts ProjectProduct[]
  feedback        Feedback[]
  activity        Activity[]
  catalogs        Catalog[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  DEVELOPING
  CUSTOMER_REVIEW
  APPROVED
  COMPLETED
  CLOSED
}

// PROJECT_PRODUCTS — resolves the Product <-> Project many-to-many relation
// and tracks reuse (usageType = REUSE increments the Reused stat).
model ProjectProduct {
  id                String               @id @default(uuid()) @db.Uuid
  projectId         String               @db.Uuid
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId         String               @db.Uuid
  product           Product              @relation(fields: [productId], references: [id])
  usageType         UsageType
  modificationNote  String?
  status            ProjectProductStatus @default(DEVELOPING)
  customerApproval  CustomerApproval     @default(PENDING)
  addedById         String               @db.Uuid
  addedBy           User                 @relation(fields: [addedById], references: [id])
  createdAt         DateTime             @default(now())

  @@unique([projectId, productId])
  @@map("project_products")
}

enum UsageType {
  NEW
  REUSE
}

enum ProjectProductStatus {
  DEVELOPING
  SALES_REVIEW
  CUSTOMER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum CustomerApproval {
  PENDING
  CHANGE_REQUESTED
  APPROVED
}

// FEEDBACK
// Usually scoped to a project, but a Product uploaded straight to the
// library (not tied to any project) needs to carry feedback too — e.g.
// an Admin's reason for rejecting it — so projectId is optional.
model Feedback {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String?         @db.Uuid
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId String?         @db.Uuid
  product   Product?        @relation(fields: [productId], references: [id])
  versionId String?         @db.Uuid
  version   ProductVersion? @relation(fields: [versionId], references: [id])
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime        @default(now())

  @@map("feedback")
}

// ACTIVITY — feeds the dashboard's "Recent Activity" list.
model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
  action    String
  createdAt DateTime @default(now())

  @@map("activity")
}

// NOTIFICATIONS — a personal inbox, distinct from Activity (the shared
// audit log). `link` points at whatever page the notification is about,
// so no extra FKs are needed per notification type.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  PRODUCT_REJECTED
}

// CATALOGS — a curated set of Products to hand to a customer who won't
// log into the app. Built two ways: picked freely from the Library
// (projectId null), or exported from a specific project's finished
// designs (projectId set, for traceability).
model Catalog {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  projectId   String?       @db.Uuid
  project     Project?      @relation(fields: [projectId], references: [id])
  customerId  String?       @db.Uuid
  customer    Customer?     @relation(fields: [customerId], references: [id])
  createdById String        @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id])
  status      CatalogStatus @default(DRAFT)
  // Set once a public "view online" link is generated for this catalog.
  publicSlug  String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items CatalogItem[]

  @@map("catalogs")
}

enum CatalogStatus {
  DRAFT
  SENT
}

model CatalogItem {
  id        String          @id @default(uuid()) @db.Uuid
  catalogId String          @db.Uuid
  catalog   Catalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId String          @db.Uuid
  product   Product         @relation(fields: [productId], references: [id])
  versionId String?         @db.Uuid
  version   ProductVersion? @relation(fields: [versionId], references: [id])
  note      String?
  sortOrder Int?
  createdAt DateTime        @default(now())

  @@unique([catalogId, productId])
  @@map("catalog_items")
}
