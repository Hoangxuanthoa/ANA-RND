// ANA-RND — Database Schema V2
// Source of truth: mock data in src/lib/mock-data.ts + the providers that
// mutate it, audited field-by-field against this schema on 2026-09-16
// (V1 predated most of the features below — My Task, Ảnh dự án, the
// expanded notification set, size/color variants, etc.). Auth is handled
// by Supabase Auth (auth.users) — `User.id` here is set to match the
// corresponding auth.users.id, it is not independently generated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// USERS
model User {
  id         String    @id @db.Uuid
  fullName   String
  email      String    @unique
  phone      String?
  role       Role
  avatar     String?
  customerId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  // Relations
  designedProducts        Product[]           @relation("Designer")
  exclusiveProducts       Product[]           @relation("ExclusiveBy")
  salesProjects           Project[]           @relation("Sales")
  rndOwnerProjects        Project[]           @relation("RndOwner")
  createdProjects         Project[]           @relation("ProjectCreator")
  uploadedAssets          ProductAsset[]
  uploadedVersions        ProductVersion[]
  feedback                Feedback[]
  activity                Activity[]
  addedProjectProducts    ProjectProduct[]    @relation("AddedBy")
  assignedProjectProducts ProjectProduct[]    @relation("Assignee")
  notifications           Notification[]
  createdCollections      Collection[]
  loggedPitches           CollectionPitch[]
  favorites               ProductFavorite[]
  uploadedAttachments     ProjectAttachment[]
  uploadedPhotos          ProjectPhoto[]      @relation("PhotoUploader")
  ownedTasks              RndTask[]           @relation("TaskOwner")
  requestedTasks          RndTask[]           @relation("TaskRequester")
  createdBreakdowns       Breakdown[]
  sharedBreakdowns        BreakdownShare[]    @relation("BreakdownSharedWith")
  breakdownActivities     BreakdownActivity[]

  @@map("users")
}

enum Role {
  ADMIN
  RND
  SALES
  MARKETING
  CUSTOMER
  // "Mua hàng" (Purchasing) — added 2026-10-02 specifically so Purchasing
  // can see the Bóc tách kỹ thuật (technical breakdown) tab alongside
  // Admin/R&D; no real staff account uses it yet (the user creates that
  // later, same as any other staff account — see scripts/seed-users.mjs).
  PURCHASING
}

// CUSTOMERS
model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  customerCode String?
  name         String
  country      String?
  contactName  String?
  contactEmail String?
  note         String?
  createdAt    DateTime @default(now())

  // Relations
  users          User[]
  projects       Project[]
  originProducts Product[]    @relation("OriginCustomer")
  collections    Collection[]

  @@map("customers")
}

// CATEGORIES / MATERIALS / SIZES / COLORS
// Four parallel lookup lists, all Admin-managed in Settings — same
// add/rename/remove shape (rename cascades to every product using the old
// value, remove blocked while any product still references it).
model Category {
  id       String     @id @default(uuid()) @db.Uuid
  name     String
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  isActive Boolean    @default(true)

  products Product[]

  @@map("categories")
}

model Material {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  isActive Boolean @default(true)

  products Product[]

  @@map("materials")
}

model Size {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  isActive Boolean @default(true)

  sizeVariants ProductSizeVariant[]

  @@map("sizes")
}

model Color {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  isActive Boolean @default(true)

  products Product[]

  @@map("colors")
}

// PRODUCTS
model Product {
  id                  String          @id @default(uuid()) @db.Uuid
  productCode         String          @unique
  name                String
  categoryId          String          @db.Uuid
  category            Category        @relation(fields: [categoryId], references: [id])
  materialId          String          @db.Uuid
  material            Material        @relation(fields: [materialId], references: [id])
  colorId             String?         @db.Uuid
  color               Color?          @relation(fields: [colorId], references: [id])
  designerId          String          @db.Uuid
  designer            User            @relation("Designer", fields: [designerId], references: [id])
  originCustomerId    String?         @db.Uuid
  originCustomer      Customer?       @relation("OriginCustomer", fields: [originCustomerId], references: [id])
  description         String?
  status              ProductStatus   @default(DRAFT)
  reusePermission     ReusePermission @default(REUSABLE)
  // Who marked it Exclusive — only ever set on a freshly-designed (NEW
  // usage) product inside a project, cleared when un-marked.
  exclusiveById       String?         @db.Uuid
  exclusiveBy         User?           @relation("ExclusiveBy", fields: [exclusiveById], references: [id])
  // Prep for connecting the existing product website later (see doc section 21).
  sourceType          SourceType      @default(RND)
  // Set when submitted via "Release to Library" from a completed project
  // rather than uploaded straight to the library — a point-in-time
  // snapshot of the project's name for the review queue, not a live FK
  // (the project the design came from can later be closed/archived).
  sourceProjectName   String?
  submittedAt         DateTime?
  lastRejectionReason String?
  // Set by bulk image upload — a placeholder record with an auto-cropped
  // image and no real name/category/material yet. Blocks Release (see
  // isProjectProductReadyToRelease) but not the review pipeline itself.
  incomplete          Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Relations
  assets          ProductAsset[]
  versions        ProductVersion[]
  sizeVariants    ProductSizeVariant[]
  projectProducts ProjectProduct[]
  feedback        Feedback[]
  activity        Activity[]
  collectionItems CollectionItem[]
  favorites       ProductFavorite[]
  releasedPhotos  ProjectPhoto[]

  @@map("products")
}

enum ProductStatus {
  DRAFT
  DEVELOPING
  // Submitted for Admin review — either uploaded straight to the library,
  // or released from a closed project. A reject sends it back to DRAFT
  // (the reason lives in Feedback + a Notification to the designer).
  PENDING_REVIEW
  RELEASED
  ARCHIVED
}

enum ReusePermission {
  REUSABLE
  EXCLUSIVE
}

enum SourceType {
  RND
  EXTERNAL
}

// A product can come in several sizes (e.g. S/M/L), each with its own
// dimensions — not one fixed size per design.
model ProductSizeVariant {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    String  @db.Uuid
  size      Size    @relation(fields: [sizeId], references: [id])
  length    Float?
  width     Float?
  height    Float?

  @@unique([productId, sizeId])
  @@map("product_size_variants")
}

// Anyone can favorite a product ("like") — one row per user per product.
// The Reused stat is computed separately from ProjectProduct (usageType =
// REUSE) and CollectionItem, not stored here.
model ProductFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("product_favorites")
}

// PRODUCT_ASSETS
model ProductAsset {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetType    AssetType
  fileName     String
  fileUrl      String
  thumbnailUrl String?
  uploadedById String    @db.Uuid
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@map("product_assets")
}

enum AssetType {
  MAIN_RENDER
  RENDER
  PRODUCT_PHOTO
  SAMPLE_PHOTO
  THREE_D_SOURCE
  DRAWING
  PDF
  OTHER
}

// PRODUCT_VERSIONS
// Versions are append-only — never delete or overwrite a previous version.
model ProductVersion {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionNumber String
  note          String?
  // Optional new main image attached with this version — also becomes the
  // product's live main image when set (see addProductVersion).
  imageUrl      String?
  uploadedById  String   @db.Uuid
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())

  feedback        Feedback[]
  collectionItems CollectionItem[]

  @@unique([productId, versionNumber])
  @@map("product_versions")
}

// PROJECTS
// Not just customer engagements — an internal or Marketing-driven
// initiative (e.g. a seasonal collection) is a Project too, just without
// a customer. `type` distinguishes them; `createdById` (not `salesId`,
// which is now optional) is what edit/delete ownership is checked against.
model Project {
  id               String        @id @default(uuid()) @db.Uuid
  projectCode      String        @unique
  projectName      String
  type             ProjectType   @default(CUSTOMER)
  customerId       String?       @db.Uuid
  customer         Customer?     @relation(fields: [customerId], references: [id])
  salesId          String?       @db.Uuid
  sales            User?         @relation("Sales", fields: [salesId], references: [id])
  rndOwnerId       String?       @db.Uuid
  rndOwner         User?         @relation("RndOwner", fields: [rndOwnerId], references: [id])
  createdById      String        @db.Uuid
  createdBy        User          @relation("ProjectCreator", fields: [createdById], references: [id])
  brief            String?
  deadline         DateTime?     @db.Date
  status           ProjectStatus @default(CREATED)
  // Stamped when markCompleted runs — feeds "Ngày hoàn thành thực tế" on
  // the R&D To Do List, rather than recomputing "today" on every render.
  completedAt      DateTime?     @db.Date
  // The rest back this project's row on the R&D/Admin "My Task" To Do
  // List (one row per project the viewer is rndOwner of). rndPriority
  // defaults to MEDIUM when absent; rndImportantNote is Admin-writable
  // only (a directive down to the rndOwner); rndNeedsSupport is
  // R&D-writable and notifies Admin when set — one-way channels in
  // opposite directions, not a shared note.
  rndPriority      TaskPriority  @default(MEDIUM)
  rndImportantNote String?
  rndNeedsSupport  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  projectProducts ProjectProduct[]
  feedback        Feedback[]
  activity        Activity[]
  collections     Collection[]
  attachments     ProjectAttachment[]
  photos          ProjectPhoto[]

  @@map("projects")
}

enum ProjectType {
  CUSTOMER
  INTERNAL
  MARKETING
}

// Simplified on purpose: per-product customer approval already lives on
// ProjectProduct.customerApproval, so the project itself doesn't need its
// own Customer Review / Approved stages — just whether work has started.
enum ProjectStatus {
  CREATED
  DEVELOPING
  COMPLETED
  CLOSED
}

// File/image attachments on a project's brief.
model ProjectAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  uploadedById String   @db.Uuid
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("project_attachments")
}

// A lightweight, un-vetted image dump attached to a Project — distinct
// from a real Product: no category/material, not part of the approval
// pipeline. Lets R&D dump reference/factory photos first and decide later
// (via "Release Library") which ones become real products; a released
// photo keeps its row here too, tagged with the resulting product so it's
// never accidentally released twice.
model ProjectPhoto {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName          String
  fileUrl           String
  uploadedById      String   @db.Uuid
  uploadedBy        User     @relation("PhotoUploader", fields: [uploadedById], references: [id])
  releasedProductId String?  @db.Uuid
  releasedProduct   Product? @relation(fields: [releasedProductId], references: [id])
  createdAt         DateTime @default(now())

  comments Feedback[]

  @@map("project_photos")
}

// PROJECT_PRODUCTS — resolves the Product <-> Project many-to-many relation
// and tracks reuse (usageType = REUSE increments the Reused stat).
model ProjectProduct {
  id                  String               @id @default(uuid()) @db.Uuid
  projectId           String               @db.Uuid
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId           String               @db.Uuid
  product             Product              @relation(fields: [productId], references: [id])
  usageType           UsageType
  modificationNote    String?
  status              ProjectProductStatus @default(DEVELOPING)
  customerApproval    CustomerApproval     @default(PENDING)
  // Set when sent back to DEVELOPING from either review stage — mirrors
  // Product.lastRejectionReason. Cleared on resubmit.
  lastRejectionReason String?
  addedById           String               @db.Uuid
  addedBy             User                 @relation("AddedBy", fields: [addedById], references: [id])
  // Which R&D person is actually doing this specific piece of work —
  // distinct from Project.rndOwnerId, which is project-wide. Feeds the
  // personal "My Tasks" queue.
  assigneeId          String?              @db.Uuid
  assignee            User?                @relation("Assignee", fields: [assigneeId], references: [id])
  createdAt           DateTime             @default(now())

  @@unique([projectId, productId])
  @@map("project_products")
}

enum UsageType {
  NEW
  REUSE
}

enum ProjectProductStatus {
  DEVELOPING
  SALES_REVIEW
  CUSTOMER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum CustomerApproval {
  PENDING
  CHANGE_REQUESTED
  APPROVED
}

// MY TASK — an ad-hoc task R&D/Admin added themselves via "Thêm công
// việc", not tied to any project. Trạng thái is deliberately not a stored
// field: it's derived as "Hoàn thành" once completedAt is filled in,
// "Đang làm" otherwise — filling in the completion date is what marks it
// done, not a separate status toggle. Shares TaskCategory/TaskPriority
// with Project.rndPriority above, since both feed the same unified To Do
// List table.
model RndTask {
  id            String       @id @default(uuid()) @db.Uuid
  ownerId       String       @db.Uuid
  owner         User         @relation("TaskOwner", fields: [ownerId], references: [id])
  title         String
  category      TaskCategory
  priority      TaskPriority @default(MEDIUM)
  requesterId   String?      @db.Uuid
  requester     User?        @relation("TaskRequester", fields: [requesterId], references: [id])
  startDate     DateTime?    @db.Date
  deadline      DateTime?    @db.Date
  completedAt   DateTime?    @db.Date
  needsSupport  String?
  // Admin-writable directive down to whoever owns this task — R&D never
  // gets edit UI for it, only Admin.
  importantNote String?
  createdAt     DateTime     @default(now())

  @@map("rnd_tasks")
}

enum TaskCategory {
  DESIGN_3D
  DRAWING
  PRICING_SUPPORT
  OTHER
}

enum TaskPriority {
  FOCUS
  HIGH
  MEDIUM
  LOW
}

// FEEDBACK
// Usually scoped to a project, but a Product uploaded straight to the
// library (not tied to any project) needs to carry feedback too — e.g.
// an Admin's reason for rejecting it — so projectId is optional. A row
// with both projectId and productId set is feedback on that specific
// project+product pairing (no separate FK to ProjectProduct needed, since
// that pair is already unique there).
model Feedback {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String?         @db.Uuid
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId      String?         @db.Uuid
  product        Product?        @relation(fields: [productId], references: [id])
  versionId      String?         @db.Uuid
  version        ProductVersion? @relation(fields: [versionId], references: [id])
  // A row with only this FK set is a comment on an unreleased Ảnh dự án
  // photo — distinct from project/product feedback above.
  projectPhotoId String?         @db.Uuid
  projectPhoto   ProjectPhoto?   @relation(fields: [projectPhotoId], references: [id], onDelete: Cascade)
  userId         String          @db.Uuid
  user           User            @relation(fields: [userId], references: [id])
  content        String
  createdAt      DateTime        @default(now())

  @@map("feedback")
}

// ACTIVITY — feeds the dashboard's "Recent Activity" list.
model Activity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
  action    String
  createdAt DateTime @default(now())

  @@map("activity")
}

// NOTIFICATIONS — a personal inbox, distinct from Activity (the shared
// audit log). `link` points at whatever page the notification is about,
// so no extra FKs are needed per notification type.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  PRODUCT_REJECTED
  PRODUCT_APPROVED
  PROJECT_ITEM_NEEDS_REVIEW
  PROJECT_ITEM_CHANGE_REQUESTED
  PROJECT_ITEM_APPROVED
  NEW_FEEDBACK
  NEW_PITCH
  PROJECT_REQUESTED_BY_CUSTOMER
  PROJECT_ASSIGNED
  RND_NEEDS_SUPPORT
  ADMIN_IMPORTANT_NOTE
  // Admin-awareness pair — every Admin gets pinged so they stay in the
  // loop team-wide, not just whoever happens to own/be assigned to the
  // project (see notify() call sites in api/projects/route.ts and
  // api/projects/[code]/products/route.ts).
  PROJECT_CREATED
  PROJECT_PRODUCT_ADDED
}

// COLLECTIONS — a curated set of Products to hand to a customer who won't
// log into the app. Built two ways: picked freely from the Library
// (projectId null), or exported from a specific project's finished
// designs (projectId set, for traceability). Stays editable even after
// being pitched — no locking.
model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  projectId   String?          @db.Uuid
  // SetNull, not the Restrict default — Admin/owner can now hard-delete a
  // project regardless of history (see canHardDeleteProject), and a
  // Collection exported from it is a real, independent artifact (already
  // shared/pitched to a customer, possibly) that shouldn't block that or
  // get destroyed by it — it just loses its "exported from" traceability.
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customerId  String?          @db.Uuid
  customer    Customer?        @relation(fields: [customerId], references: [id])
  createdById String           @db.Uuid
  createdBy   User             @relation(fields: [createdById], references: [id])
  status      CollectionStatus @default(DRAFT)
  // Set once a public "view online" link is generated for this collection.
  publicSlug  String?          @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items   CollectionItem[]
  pitches CollectionPitch[]

  @@map("collections")
}

enum CollectionStatus {
  DRAFT
  SENT
}

model CollectionItem {
  id           String          @id @default(uuid()) @db.Uuid
  collectionId String          @db.Uuid
  collection   Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id])
  versionId    String?         @db.Uuid
  version      ProductVersion? @relation(fields: [versionId], references: [id])
  note         String?
  sortOrder    Int?
  createdAt    DateTime        @default(now())

  @@unique([collectionId, productId])
  @@map("collection_items")
}

// Logged at export/share time (not a separate optional step) — getting
// the file/link requires saying who it's for. Append-only, same as
// Feedback — a pitch log entry is never edited or removed once recorded,
// so the history stays trustworthy.
model CollectionPitch {
  id           String     @id @default(uuid()) @db.Uuid
  collectionId String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  customerName String
  note         String?
  loggedById   String     @db.Uuid
  loggedBy     User       @relation(fields: [loggedById], references: [id])
  createdAt    DateTime   @default(now())

  @@map("collection_pitches")
}

// BÓC TÁCH KỸ THUẬT (technical breakdown) — ported from the standalone
// ANASU Web app (its own repo, local-IndexedDB-only) as a real ANA-RND tab.
// One Breakdown groups the products broken down for one sales quote (e.g.
// "ANA-ADE-022026"); each BreakdownProduct holds that ENTIRE product's state
// (rings, frame, material incl. base64 texture images, lid, handle,
// scallop, …) as one JSON blob rather than a fully normalized schema — the
// geometry engine already treats it as one cohesive object end to end (see
// anasu-web's ProductState type), nothing here needs to be queried field by
// field in SQL, and this keeps the port fast and exactly in sync with
// whatever ANASU's own geometry engine's shape evolves into, instead of a
// 100+ column table that would need a migration every time that engine
// grows a field. Material/photo images stay inline base64 inside this JSON
// for now (not Supabase Storage/R2 like ProductAsset) — a deliberate,
// revisit-later simplification agreed with the user (2026-10-02) to keep
// this first port small; swapping to real object storage later only
// touches the material-image read/write code, not this schema.
model Breakdown {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  createdById     String   @db.Uuid
  createdBy       User     @relation(fields: [createdById], references: [id])
  // Which of its own products the studio should reopen to by default —
  // a plain id, not a real relation, so deleting that product doesn't need
  // a cascade/SetNull rule of its own; a stale/missing id just falls back
  // to "first product" client-side, same as ANASU's original
  // `products.find(...) ?? products[0]` behavior.
  activeProductId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products BreakdownProduct[]
  shares   BreakdownShare[]
  activity BreakdownActivity[]

  @@map("breakdowns")
}

// Sharing a breakdown with another staff member: a row here gives that user
// READ-ONLY access (they see it in their list and can open every product,
// drawing and BOM, but not edit/delete) — the owner (createdBy) and Admin keep
// full control, and Admin sees every breakdown regardless.
model BreakdownShare {
  id          String    @id @default(uuid()) @db.Uuid
  breakdownId String    @db.Uuid
  breakdown   Breakdown @relation(fields: [breakdownId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation("BreakdownSharedWith", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([breakdownId, userId])
  @@map("breakdown_shares")
}

// Edit history of a breakdown ("Lịch sử chỉnh sửa") — one row per burst of
// changes, not per keystroke: the studio autosaves continuously, so the server
// folds edits by the same person to the same product within a short window into
// one row (see lib/server/breakdown-activity.ts). `details` holds the raw
// bits a row was built from (e.g. which field groups changed) so a merge can
// extend it; `summary` is the human-readable line shown in the UI.
model BreakdownActivity {
  id          String    @id @default(uuid()) @db.Uuid
  breakdownId String    @db.Uuid
  breakdown   Breakdown @relation(fields: [breakdownId], references: [id], onDelete: Cascade)
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // "edit" | "product_add" | "product_duplicate" | "product_delete" | "reorder" | "rename" | "share" | "create"
  productCode String? // the product's own "P001"-style id, when the entry is about one product
  productName String?
  summary     String
  details     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([breakdownId, createdAt])
  @@map("breakdown_activity")
}

model BreakdownProduct {
  id          String    @id @default(uuid()) @db.Uuid
  breakdownId String    @db.Uuid
  breakdown   Breakdown @relation(fields: [breakdownId], references: [id], onDelete: Cascade)
  // ANASU's own per-product id, e.g. "P001" — unique within its breakdown,
  // kept as a plain display/sort field (not this row's own primary key)
  // since the geometry engine already mints and relies on these ids inside
  // `data` itself.
  code        String
  name        String
  sortOrder   Int       @default(0)
  data        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([breakdownId, code])
  @@map("breakdown_products")
}

// Breakdown drawing export templates (title-block branding, which views,
// field list) — GLOBAL and shared across every breakdown/product, not owned
// by any one of them. Admin-managed only (create/edit/delete); every other
// role that can open the breakdown studio can read the list and pick one to
// export with, but can't change it — see canManageDrawingTemplates.
// "Quy cách hàng đan" — Admin-editable auto-fill rules for the steel frame, one
// row per shape ("round", later "square", …). `config` is the shape's rule
// tables + fixed values (see lib/breakdown/weaveSpec.ts); no row = defaults.
model WeaveSpec {
  shape     String   @id
  config    Json
  updatedAt DateTime @updatedAt

  @@map("weave_specs")
}

model DrawingTemplate {
  id                  String   @id @default(uuid())
  name                String
  companyName         String
  logoDataUrl         String?
  // DrawingViewKey[] (front/back/left/right/top/bottom/iso)
  views               Json
  // DrawingTemplateField[] ({ id, label, autoFill?, defaultValue? })
  fields              Json
  titleBlockWidthMm   Float
  fieldRowMinHeightMm Float
  showViewFrame       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("drawing_templates")
}

// APP SETTINGS — a singleton row (Admin-only, Settings' "Mẫu PPTX" tab)
// for the Collection PPTX/PDF export's cover/closing template. Category/
// Material/Size/Color management doesn't need a settings row of its own —
// those are just CRUD on their own lookup tables above.
model AppSettings {
  id               String  @id @default(uuid())
  pptxCoverImage   String?
  pptxClosingImage String?
  pptxClosingText  String  @default("Cảm ơn quý khách")
  // Roles (besides Admin, who always can) allowed to open "Cài đặt Bóc tách" —
  // a JSON array of Role strings; null/absent = Admin only. See
  // lib/server/breakdown-settings-access.ts.
  breakdownSettingsRoles Json?

  @@map("app_settings")
}
