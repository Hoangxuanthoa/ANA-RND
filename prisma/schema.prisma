generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// USERS
model User {
  id        String     @id @default(cuid())
  fullName  String
  email     String     @unique
  passwordHash String
  role      Role       @default(RND) // RND, SALES, CUSTOMER, ADMIN
  avatar    String?
  customerId String?
  customer  Customer?  @relation(fields: [customerId], references: [id])
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  designedProducts    Product[] @relation("Designer")
  createdProjects     Project[] @relation("Sales")
  ownedProjects       Project[] @relation("RNDOwner")
  uploadedAssets      ProductAsset[]
  uploadedVersions    ProductVersion[]
  feedback            Feedback[]
  activity            Activity[]
  createdCollections  Collection[]
  addedProjectProducts ProjectProduct[]

  @@map("users")
}

enum Role {
  RND
  SALES
  CUSTOMER
  ADMIN
}

// CUSTOMERS
model Customer {
  id            String     @id @default(cuid())
  customerCode  String?
  name          String
  country       String?
  contactName   String?
  contactEmail  String?
  note          String?
  createdAt     DateTime   @default(now())

  // Relations
  users         User[]
  projects      Project[]
  collections   Collection[]
  originProducts Product[] @relation("OriginCustomer")

  @@map("customers")
}

// CATEGORIES
model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  isActive  Boolean    @default(true)
  products  Product[]

  @@map("categories")
}

// MATERIALS
model Material {
  id        String     @id @default(cuid())
  name      String
  isActive  Boolean    @default(true)

  // Relations
  products  ProductMaterial[]

  @@map("materials")
}

// PRODUCTS
model Product {
  id                 String     @id @default(cuid())
  productCode        String     @unique
  name               String
  categoryId         String
  category           Category   @relation(fields: [categoryId], references: [id])
  style              String?
  designerId         String
  designer           User       @relation("Designer", fields: [designerId], references: [id])
  originCustomerId   String?
  originCustomer     Customer?  @relation("OriginCustomer", fields: [originCustomerId], references: [id])
  description        String?

  // Dimensions
  length             Decimal?   @db.Decimal(10, 2)
  width              Decimal?   @db.Decimal(10, 2)
  height             Decimal?   @db.Decimal(10, 2)
  unit               String     @default("cm") // cm, inch, m

  // Order info
  moq                Int?       // Minimum Order Quantity

  // Packaging
  packageLength      Decimal?   @db.Decimal(10, 2)
  packageWidth       Decimal?   @db.Decimal(10, 2)
  packageHeight      Decimal?   @db.Decimal(10, 2)
  packageWeight      Decimal?   @db.Decimal(10, 2)

  // Status
  status             ProductStatus @default(DRAFT) // Draft, Developing, Approved, Released, Archived
  reusePermission    ReusePermission @default(REUSABLE) // Reusable, Reference Only, Exclusive

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  materials          ProductMaterial[]
  assets             ProductAsset[]
  versions           ProductVersion[]
  projectProducts    ProjectProduct[]
  collectionItems    CollectionItem[]
  feedback           Feedback[]
  activity           Activity[]

  @@map("products")
}

enum ProductStatus {
  DRAFT
  DEVELOPING
  APPROVED
  RELEASED
  ARCHIVED
}

enum ReusePermission {
  REUSABLE
  REFERENCE_ONLY
  EXCLUSIVE
}

// PRODUCT_MATERIALS (many-to-many)
model ProductMaterial {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material   @relation(fields: [materialId], references: [id])
  percentage  Int?       // Percentage of material
  createdAt   DateTime   @default(now())

  @@unique([productId, materialId])
  @@map("product_materials")
}

// PRODUCT_ASSETS
model ProductAsset {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetType    AssetType
  fileName     String
  fileUrl      String
  thumbnailUrl String?
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime   @default(now())

  @@map("product_assets")
}

enum AssetType {
  MAIN_RENDER
  RENDER
  PRODUCT_PHOTO
  SAMPLE_PHOTO
  THREE_D_SOURCE
  DRAWING
  PDF
  OTHER
}

// PRODUCT_VERSIONS
model ProductVersion {
  id               String     @id @default(cuid())
  productId        String
  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  versionNumber    String
  note             String?
  isCustomerReady  Boolean    @default(false)
  uploadedById     String
  uploadedBy       User       @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime   @default(now())

  // Relations
  feedback         Feedback[]
  resolvedFeedback Feedback[] @relation("ResolvedInVersion")
  collectionItems  CollectionItem[]

  @@unique([productId, versionNumber])
  @@map("product_versions")
}

// PROJECTS
model Project {
  id            String     @id @default(cuid())
  projectCode   String     @unique
  projectName   String
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id])
  salesId       String
  sales         User       @relation("Sales", fields: [salesId], references: [id])
  rndOwnerId    String?
  rndOwner      User?      @relation("RNDOwner", fields: [rndOwnerId], references: [id])
  brief         String?
  deadline      DateTime?
  status        ProjectStatus @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  projectProducts ProjectProduct[]
  collections     Collection[]
  feedback        Feedback[]
  activity        Activity[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  DEVELOPING
  CUSTOMER_REVIEW
  APPROVED
  COMPLETED
  CLOSED
}

// PROJECT_PRODUCTS
model ProjectProduct {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  usageType         UsageType
  modificationNote  String?
  customDimensions  String?
  status            ProjectProductStatus @default(DEVELOPING)
  customerApproval  CustomerApproval @default(PENDING)
  addedById         String
  addedBy           User       @relation(fields: [addedById], references: [id])
  createdAt         DateTime   @default(now())

  @@unique([projectId, productId])
  @@map("project_products")
}

enum UsageType {
  NEW
  REUSE
}

enum ProjectProductStatus {
  DEVELOPING
  SALES_REVIEW
  CUSTOMER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum CustomerApproval {
  PENDING
  CHANGE_REQUESTED
  APPROVED
}

// COLLECTIONS
model Collection {
  id          String     @id @default(cuid())
  name        String
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  status      CollectionStatus @default(DRAFT) // Draft, Sent, Approved
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  items       CollectionItem[]

  @@map("collections")
}

enum CollectionStatus {
  DRAFT
  SENT
  APPROVED
}

// COLLECTION_ITEMS
model CollectionItem {
  id             String     @id @default(cuid())
  collectionId   String
  collection     Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  versionId      String?
  version        ProductVersion? @relation(fields: [versionId], references: [id])
  note           String?
  sortOrder      Int?
  createdAt      DateTime   @default(now())

  @@map("collection_items")
}

// FEEDBACK
model Feedback {
  id                   String     @id @default(cuid())
  projectId            String
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product?   @relation(fields: [productId], references: [id])
  versionId            String?
  version              ProductVersion? @relation(fields: [versionId], references: [id])
  userId               String
  user                 User       @relation(fields: [userId], references: [id])
  content              String
  status               FeedbackStatus @default(OPEN)
  resolvedInVersionId  String?
  resolvedInVersion    ProductVersion? @relation(name: "ResolvedInVersion", fields: [resolvedInVersionId], references: [id])
  createdAt            DateTime   @default(now())

  @@map("feedback")
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

// ACTIVITY
model Activity {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  action      String
  createdAt   DateTime   @default(now())

  @@map("activity")
}
