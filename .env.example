# Supabase Postgres connection (Prisma).
# Pooled connection (via pgbouncer) — used at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct connection — used for migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase project — also backs real Auth (login) and Storage (3D model
# files), public client.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
# Server-only, bypasses RLS — used to create/manage auth users (see
# scripts/seed-users.mjs). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# Cloudflare R2 (S3-compatible) — real image storage, server-only. The
# API token behind these keys must be scoped to R2_BUCKET_NAME only,
# never "all buckets" (this Cloudflare account also hosts other sites).
R2_ACCOUNT_ID="[ACCOUNT_ID]"
R2_ACCESS_KEY_ID="[ACCESS_KEY_ID]"
R2_SECRET_ACCESS_KEY="[SECRET_ACCESS_KEY]"
R2_BUCKET_NAME="[BUCKET_NAME]"
# Public base URL for reading uploaded files back (r2.dev subdomain or
# a custom domain proxied through Cloudflare) — no trailing slash.
R2_PUBLIC_URL="https://pub-[HASH].r2.dev"
